# Embeds the GUI wallet's HTML/CSS/JS into the binary (no files are read at run time, nothing is fetched from the network).
# Generates ${OUT} defining GUI_ASSETS[] / GUI_ASSET_COUNT (see src/gui_assets.h). Re-runs configure when an asset changes.
function(plk_embed_gui OUT)
  set(src "")
  set(table "")
  set(i 0)
  foreach(spec ${ARGN})
    string(REPLACE "|" ";" parts "${spec}")
    list(GET parts 0 route)
    list(GET parts 1 file)
    list(GET parts 2 type)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${file})
    file(READ ${file} hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND src "static const unsigned char asset${i}[] = {${bytes}0};\n")
    string(APPEND table "  {\"${route}\", \"${type}\", asset${i}, sizeof(asset${i}) - 1},\n")
    math(EXPR i "${i}+1")
  endforeach()
  file(WRITE ${OUT}.tmp "// Generated by cmake/embed.cmake - do not edit\n#include \"gui_assets.h\"\nnamespace plk {\n${src}const GuiAsset GUI_ASSETS[] = {\n${table}};\nconst size_t GUI_ASSET_COUNT = ${i};\n}  // namespace plk\n")
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
endfunction()
